+const matchSymbols = buildString({
+  loneCodePoints: [],
+  ranges: [
+    [0x03D000, 0x03FC3F]
+  ]
+});
+testPropertyEscapes(
+  /^\p{Script=Seal}+$/u,
+  matchSymbols,
+  "\\p{Script=Seal}"
+);
+testPropertyEscapes(
+  /^\p{Script=Seal}+$/u,
+  matchSymbols,
+  "\\p{Script=Seal}"
+);
+testPropertyEscapes(
+  /^\p{sc=Seal}+$/u,
+  matchSymbols,
+  "\\p{sc=Seal}"
+);
+testPropertyEscapes(
+  /^\p{sc=Seal}+$/u,
+  matchSymbols,
+  "\\p{sc=Seal}"
+);
+
+const nonMatchSymbols = buildString({
+  loneCodePoints: [],
+  ranges: [
+    [0x00DC00, 0x00DFFF],
+    [0x000000, 0x00DBFF],
+    [0x00E000, 0x03CFFF],
+    [0x03FC40, 0x10FFFF]
+  ]
+});
+testPropertyEscapes(
+  /^\P{Script=Seal}+$/u,
+  nonMatchSymbols,
+  "\\P{Script=Seal}"
+);
+testPropertyEscapes(
+  /^\P{Script=Seal}+$/u,
+  nonMatchSymbols,
+  "\\P{Script=Seal}"
+);
+testPropertyEscapes(
+  /^\P{sc=Seal}+$/u,
+  nonMatchSymbols,
+  "\\P{sc=Seal}"
+);
+testPropertyEscapes(
+  /^\P{sc=Seal}+$/u,
+  nonMatchSymbols,
+  "\\P{sc=Seal}"
+);
