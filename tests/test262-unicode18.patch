+// Copyright 2026 Mathias Bynens. All rights reserved.
+// This code is governed by the BSD license found in the LICENSE file.
+
+/*---
+author: Mathias Bynens
+description: >
+  Unicode property escapes for `Script=Proto_Cuneiform`
+info: |
+  Generated by https://github.com/mathiasbynens/unicode-property-escapes-tests
+  Unicode v18.0.0
+esid: sec-static-semantics-unicodematchproperty-p
+features: [regexp-unicode-property-escapes]
+includes: [regExpUtils.js]
+---*/
+
+const matchSymbols = buildString({
+  loneCodePoints: [],
+  ranges: [
+    [0x0125A8, 0x01264B]
+  ]
+});
+testPropertyEscapes(
+  /^\p{Script=Proto_Cuneiform}+$/u,
+  matchSymbols,
+  "\\p{Script=Proto_Cuneiform}"
+);
+testPropertyEscapes(
+  /^\p{Script=Pcun}+$/u,
+  matchSymbols,
+  "\\p{Script=Pcun}"
+);
+testPropertyEscapes(
+  /^\p{sc=Proto_Cuneiform}+$/u,
+  matchSymbols,
+  "\\p{sc=Proto_Cuneiform}"
+);
+testPropertyEscapes(
+  /^\p{sc=Pcun}+$/u,
+  matchSymbols,
+  "\\p{sc=Pcun}"
+);
+
+const nonMatchSymbols = buildString({
+  loneCodePoints: [],
+  ranges: [
+    [0x00DC00, 0x00DFFF],
+    [0x000000, 0x00DBFF],
+    [0x00E000, 0x0125A7],
+    [0x01264C, 0x10FFFF]
+  ]
+});
+testPropertyEscapes(
+  /^\P{Script=Proto_Cuneiform}+$/u,
+  nonMatchSymbols,
+  "\\P{Script=Proto_Cuneiform}"
+);
+testPropertyEscapes(
+  /^\P{Script=Pcun}+$/u,
+  nonMatchSymbols,
+  "\\P{Script=Pcun}"
+);
+testPropertyEscapes(
+  /^\P{sc=Proto_Cuneiform}+$/u,
+  nonMatchSymbols,
+  "\\P{sc=Proto_Cuneiform}"
+);
+testPropertyEscapes(
+  /^\P{sc=Pcun}+$/u,
+  nonMatchSymbols,
+  "\\P{sc=Pcun}"
+);
