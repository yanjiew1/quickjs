+/*---
+author: Mathias Bynens
+description: >
+  Unicode property escapes for `Script=Jurchen`
+info: |
+  Generated by https://github.com/mathiasbynens/unicode-property-escapes-tests
+  Unicode v18.0.0
+esid: sec-static-semantics-unicodematchproperty-p
+features: [regexp-unicode-property-escapes]
+includes: [regExpUtils.js]
+---*/
+
+const matchSymbols = buildString({
+  loneCodePoints: [],
+  ranges: [
+    [0x018E00, 0x019191],
+    [0x0191A0, 0x0191D2]
+  ]
+});
+testPropertyEscapes(
+  /^\p{Script=Jurchen}+$/u,
+  matchSymbols,
+  "\\p{Script=Jurchen}"
+);
+testPropertyEscapes(
+  /^\p{Script=Jurc}+$/u,
+  matchSymbols,
+  "\\p{Script=Jurc}"
+);
+testPropertyEscapes(
+  /^\p{sc=Jurchen}+$/u,
+  matchSymbols,
+  "\\p{sc=Jurchen}"
+);
+testPropertyEscapes(
+  /^\p{sc=Jurc}+$/u,
+  matchSymbols,
+  "\\p{sc=Jurc}"
+);
+
+const nonMatchSymbols = buildString({
+  loneCodePoints: [],
+  ranges: [
+    [0x00DC00, 0x00DFFF],
+    [0x000000, 0x00DBFF],
+    [0x00E000, 0x018DFF],
+    [0x019192, 0x01919F],
+    [0x0191D3, 0x10FFFF]
+  ]
+});
+testPropertyEscapes(
+  /^\P{Script=Jurchen}+$/u,
+  nonMatchSymbols,
+  "\\P{Script=Jurchen}"
+);
+testPropertyEscapes(
+  /^\P{Script=Jurc}+$/u,
+  nonMatchSymbols,
+  "\\P{Script=Jurc}"
+);
+testPropertyEscapes(
+  /^\P{sc=Jurchen}+$/u,
+  nonMatchSymbols,
+  "\\P{sc=Jurchen}"
+);
+testPropertyEscapes(
+  /^\P{sc=Jurc}+$/u,
+  nonMatchSymbols,
+  "\\P{sc=Jurc}"
+);
