+    }
+    return result;
+  }
   for (let i = 0; i < ranges.length; i++) {
     let range = ranges[i];
     let start = range[0];
     let end = range[1];
     let codePoints = [];
     for (let length = 0, codePoint = start; codePoint <= end; codePoint++) {
       codePoints[length++] = codePoint;
       if (length === CHUNK_SIZE) {
