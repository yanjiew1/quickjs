 assert.sameValue(closed, true);
+
+// A large valid limit does not close the source during helper creation.
+closed = false;
+let acquired = 0;
+let large = {
+  __proto__: Iterator.prototype,
+  get next() {
+    acquired += 1;
+    return function () { return { done: true }; };
