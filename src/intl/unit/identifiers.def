/* ECMA-402 sanctioned single units and their CLDR data identifiers.
 * Keep canonical identifiers sorted. Included with QJS_INTL_UNIT defined. */
QJS_INTL_UNIT("acre", "area-acre")
QJS_INTL_UNIT("bit", "digital-bit")
QJS_INTL_UNIT("byte", "digital-byte")
QJS_INTL_UNIT("celsius", "temperature-celsius")
QJS_INTL_UNIT("centimeter", "length-centimeter")
QJS_INTL_UNIT("day", "duration-day")
QJS_INTL_UNIT("degree", "angle-degree")
QJS_INTL_UNIT("fahrenheit", "temperature-fahrenheit")
QJS_INTL_UNIT("fluid-ounce", "volume-fluid-ounce")
QJS_INTL_UNIT("foot", "length-foot")
QJS_INTL_UNIT("gallon", "volume-gallon")
QJS_INTL_UNIT("gigabit", "digital-gigabit")
QJS_INTL_UNIT("gigabyte", "digital-gigabyte")
QJS_INTL_UNIT("gram", "mass-gram")
QJS_INTL_UNIT("hectare", "area-hectare")
QJS_INTL_UNIT("hour", "duration-hour")
QJS_INTL_UNIT("inch", "length-inch")
QJS_INTL_UNIT("kilobit", "digital-kilobit")
QJS_INTL_UNIT("kilobyte", "digital-kilobyte")
QJS_INTL_UNIT("kilogram", "mass-kilogram")
QJS_INTL_UNIT("kilometer", "length-kilometer")
QJS_INTL_UNIT("liter", "volume-liter")
QJS_INTL_UNIT("megabit", "digital-megabit")
QJS_INTL_UNIT("megabyte", "digital-megabyte")
QJS_INTL_UNIT("meter", "length-meter")
QJS_INTL_UNIT("microsecond", "duration-microsecond")
QJS_INTL_UNIT("mile", "length-mile")
QJS_INTL_UNIT("mile-scandinavian", "length-mile-scandinavian")
QJS_INTL_UNIT("milliliter", "volume-milliliter")
QJS_INTL_UNIT("millimeter", "length-millimeter")
QJS_INTL_UNIT("millisecond", "duration-millisecond")
QJS_INTL_UNIT("minute", "duration-minute")
QJS_INTL_UNIT("month", "duration-month")
QJS_INTL_UNIT("nanosecond", "duration-nanosecond")
QJS_INTL_UNIT("ounce", "mass-ounce")
QJS_INTL_UNIT("percent", "concentr-percent")
QJS_INTL_UNIT("petabyte", "digital-petabyte")
QJS_INTL_UNIT("pound", "mass-pound")
QJS_INTL_UNIT("second", "duration-second")
QJS_INTL_UNIT("stone", "mass-stone")
QJS_INTL_UNIT("terabit", "digital-terabit")
QJS_INTL_UNIT("terabyte", "digital-terabyte")
QJS_INTL_UNIT("week", "duration-week")
QJS_INTL_UNIT("yard", "length-yard")
QJS_INTL_UNIT("year", "duration-year")
